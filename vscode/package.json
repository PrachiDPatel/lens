{
    "categories": [
        "Other"
    ],
    "contributes": {
        "commands": [
            {
                "command": "lens.copyContext",
                "title": "Lens: Copy code context for AI"
            },
            {
                "command": "lens.askCopilot",
                "title": "Lens: Ask Copilot about this code"
            },
            {
                "command": "lens.setApiKey",
                "title": "Lens: Set Anthropic API key"
            },
            {
                "command": "lens.deleteApiKey",
                "title": "Lens: Delete Anthropic API key"
            },
            {
                "command": "lens.sendToClaude",
                "title": "Lens: Send to Claude"
            },
            {
                "command": "lens.openPanel",
                "title": "Lens: Open Lens panel"
            }
        ],
        "configuration": {
            "title": "Lens",
            "properties": {
                "lens.anthropicModel": {
                    "type": "string",
                    "default": "",
                    "description": "Claude model id used by Lens direct-send. Set automatically when you save an API key, picked from your account's own model list."
                }
            }
        },
        "menus": {
            "editor/context": [
                {
                    "command": "lens.copyContext",
                    "group": "lens",
                    "when": "editorTextFocus"
                },
                {
                    "command": "lens.askCopilot",
                    "group": "lens",
                    "when": "editorTextFocus"
                },
                {
                    "command": "lens.sendToClaude",
                    "group": "lens",
                    "when": "editorTextFocus"
                }
            ]
        },
        "views": {
            "lens": [
                {
                    "id": "lens.panel",
                    "name": "Lens",
                    "type": "webview"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "icon": "media/lens.svg",
                    "id": "lens",
                    "title": "Lens"
                }
            ]
        }
    },
    "description": "Show, don't screenshot. Copies rich code context \u2014 your file or selection, problems, and open files \u2014 to the clipboard so you can paste it into any AI chat.",
    "displayName": "Lens",
    "engines": {
        "vscode": "^1.85.0"
    },
    "main": "./extension.js",
    "name": "lens",
    "publisher": "lens",
    "scripts": {
        "package": "vsce package"
    },
    "version": "0.1.0"
}
